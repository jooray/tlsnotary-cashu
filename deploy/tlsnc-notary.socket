# nginx talks to the notary over this Unix socket, so the service itself can
# be denied every local IP address (IPAddressDeny= in the service).
[Unit]
Description=tlsnotary-cashu notary socket

[Socket]
ListenStream=/run/tlsnc/notary.sock
SocketUser=tlsnc
SocketGroup=nginx
SocketMode=0660
DirectoryMode=0755

[Install]
WantedBy=sockets.target
