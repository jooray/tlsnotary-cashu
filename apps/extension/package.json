  },
  "dependencies": {
    "@cashu/cashu-ts": "^4.12.0",
    "@scure/bip39": "2.4.0",
    "@tlsnc/client": "*",
    "@tlsnc/verify": "*",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@types/chrome": "0.3.4",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
